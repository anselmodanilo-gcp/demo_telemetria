# ==============================================================================
# CONFIGURAÇÕES DO SIMULADOR DE TELEMETRIA GCP - BRASIL
# ==============================================================================

# Intervalo em segundos entre cada emissão de telemetria por veículo (padrão: 4.0s)
SIMULATION_INTERVAL_SECONDS=4.0

# Quantidade de veículos simultâneos (padrão: 10)
VEHICLE_COUNT=10

# Multiplicador de velocidade para acelerar o deslocamento durante testes (1.0 = tempo real)
SIMULATION_SPEED_MULTIPLIER=1.0

# Modo de transmissão: http, websocket, console, ou all
TRANSMISSION_MODE=http

# Endpoint do Servidor de Destino (pode ser o servidor local, Cloud Run, Cloud Functions, ou API Gateway)
TARGET_SERVER_URL=http://127.0.0.1:8000/api/v1/telemetry
BATCH_TARGET_SERVER_URL=http://127.0.0.1:8000/api/v1/telemetry/batch
WEBSOCKET_URL=ws://127.0.0.1:8000/ws/telemetry

# Token de autenticação opcional (Bearer token)
# AUTH_BEARER_TOKEN=sua_chave_secreta_aqui

# Buffer Offline SQLite para proteção contra perda de dados em queda de rede
ENABLE_OFFLINE_BUFFER=true
OFFLINE_BUFFER_DB=telemetry_offline_buffer.db
BUFFER_FLUSH_BATCH_SIZE=25
HTTP_TIMEOUT_SECONDS=3.5

# Google Maps API (Opcional - caso queira traçar rotas e obter elevações dinamicamente)
# GOOGLE_MAPS_API_KEY=AIzaSy...

# Configurações do Servidor Receptor Embutido e Dashboard
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
LOG_LEVEL=INFO
